PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret-before-deployment
GROUP_NAME=The Good Times Club
TIMEZONE=Asia/Dhaka
FIREBASE_PROJECT_ID=f-website-f9e07
# Keep the service-account JSON private. Base64-encode its contents and set this
# only in Render's Environment settings (not in this tracked example file).
FIREBASE_ADMIN_SERVICE_ACCOUNT_BASE64=
# Copy the exact default bucket name from Firebase Console > Storage.
FIREBASE_STORAGE_BUCKET=
# Optional Twilio SMS integration. Create a Twilio account and configure an SMS-capable sender.
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Optional WebRTC call connectivity. Use a TURN service with REST shared-secret auth.
STUN_SERVERS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_SHARED_SECRET=
